{
  "displayName": "Price Bars",
  "reportName": "PriceBars",
  "parameters": [
    {
      "name": "date",
      "description": "Trading date or date range.",
      "required": true,
      "format": "YYYY-MM-DD"
    },
    {
      "name": "symbol",
      "description": "Stock ticker symbol.",
      "required": true,
      "format": "string"
    },
    {
      "name": "interval_minutes",
      "description": "Bar interval in minutes.",
      "required": true,
      "format": "integer"
    }
  ],
  "columns": [
    { "name": "date", "description": "Bar date" },
