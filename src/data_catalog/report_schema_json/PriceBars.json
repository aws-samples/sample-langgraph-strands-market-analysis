    { "name": "high", "description": "Highest price in the bar" },
    { "name": "low", "description": "Lowest price in the bar" },
    { "name": "volume", "description": "Total shares traded in the bar" },
    { "name": "num_trades", "description": "Number of trades in the bar" },
    { "name": "vwap", "description": "Volume-weighted average price" }
